# OS / editors
.DS_Store
Thumbs.db
.idea/
*.iml
*.suo
*.sw?
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log

# Node / frontend (see also app/.gitignore)
node_modules/

# Rust / Tauri
target/

# Kotlin / Gradle (server)
.gradle/
.kotlin/
build/
!gradle/wrapper/gradle-wrapper.jar

# Upstream binary assets (fonts, test images): not committed, restored by
# tools/fetch-upstream-assets.ps1 from Suwayomi-Server at the pinned commit (see server/UPSTREAM.md)
server/AndroidCompat/src/main/resources/font/**/*.ttf
server/**/src/test/resources/*.heif
server/**/src/test/resources/*.avif
server/**/src/test/resources/*.jxl

# Local tool binaries (dex2jar, jadx, mpv builds, test APKs, jlink output)
tools/bin/
tools/apks/
tools/upstream/

# Dev data dir used by tools/run-server.ps1 (database, settings, extensions, logs)
tools/dev-data/

# Spike outputs (downloaded indexes, harness results, logs)
spikes/**/out/
*.apk
*.dex

# Local env
.env
.env.*
!.env.example
